<Project Sdk="Microsoft.NET.Sdk.Web">

    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <UserSecretsId>ba058ad0-5eaf-4b81-8526-0ae956b6c7ef</UserSecretsId>
    </PropertyGroup>

    <ItemGroup>
      <PackageReference Include="FluentValidation" Version="12.2.0" />
      <PackageReference Include="FluentValidation.DependencyInjectionExtensions" Version="12.2.0" />
      <PackageReference Include="frytech.AppleMusic.API" Version="1.0.4" />
      <PackageReference Include="frytech.Essentials.FluentValidation.Tools" Version="1.0.0" />
      <PackageReference Include="KeyedSemaphores" Version="6.1.0" />
      <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.13">
        <PrivateAssets>all</PrivateAssets>
        <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      </PackageReference>
      <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="10.0.13" />
      <PackageReference Include="Microsoft.Extensions.Configuration" Version="10.0.13" />
      <PackageReference Include="Microsoft.Extensions.Configuration.Binder" Version="10.0.13" />
      <PackageReference Include="Microsoft.Extensions.Configuration.CommandLine" Version="10.0.13" />
      <PackageReference Include="Microsoft.Extensions.Configuration.Json" Version="10.0.13" />
      <PackageReference Include="Telegram.Bot" Version="22.10.3.3" />
    </ItemGroup>

    <ItemGroup>
      <EmbeddedResource Update="Resources\TelegramMessages.resx">
        <Generator>ResXFileCodeGenerator</Generator>
        <LastGenOutput>TelegramMessages.Designer.cs</LastGenOutput>
      </EmbeddedResource>
      <Compile Update="Resources\TelegramMessages.Designer.cs">
        <DesignTime>True</DesignTime>
        <AutoGen>True</AutoGen>
        <DependentUpon>TelegramMessages.resx</DependentUpon>
      </Compile>
    </ItemGroup>

</Project>
