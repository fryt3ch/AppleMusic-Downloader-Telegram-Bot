# This file is passed to the bot container as-is via `env_file` in docker-compose.yml.
# Only variables listed here are applied; anything omitted falls back to the code defaults.

# ---------------------------------------------------------------------------
# Telegram
# ---------------------------------------------------------------------------
TELEGRAM__BOT_TOKEN=
TELEGRAM__STORAGE_CHAT_ID=

# Public Bot API (default). For a local Bot API server use:
# TELEGRAM__SERVER_API_URL=http://telegram-bot-api:8081
TELEGRAM__SERVER_API_URL=https://api.telegram.org

TELEGRAM__PROGRESS_UPDATE_INTERVAL_SECONDS=2
# TELEGRAM__THUMBNAIL_SIZE=1200
# TELEGRAM__THUMBNAIL_PREVIEW_SIZE=120

# Webhook mode is optional. Leave disabled for long polling.
TELEGRAM__WEBHOOK__ENABLED=false
# TELEGRAM__WEBHOOK__URL=https://example.com
# TELEGRAM__WEBHOOK__PATH=/api/bot/update
# TELEGRAM__WEBHOOK__SECRET_TOKEN=
# TELEGRAM__WEBHOOK__MAX_CONNECTIONS=50

# ---------------------------------------------------------------------------
# Apple Music
# ---------------------------------------------------------------------------
# Required for search and metadata, even when DOWNLOADER__PROVIDER=ytdlp.
APPLE_MUSIC__API_TOKEN=
APPLE_MUSIC__DEFAULT_STORE=us
# Override only if Apple changes the Catalog API endpoint.
# APPLE_MUSIC__STORE_API_URL=https://amp-api-edge.music.apple.com/v1/

# ---------------------------------------------------------------------------
# Downloader
# ---------------------------------------------------------------------------
# gamdl  - Apple Music audio (requires subscription + Apple cookies)
# ytdlp  - YouTube audio (free, optional YouTube cookies)
DOWNLOADER__PROVIDER=ytdlp

DOWNLOADER__PROCESS_TIMEOUT_SECONDS=300
DOWNLOADER__MAX_CONCURRENCY=3
DOWNLOADER__DELAY_AFTER_DOWNLOAD_SECONDS=3

# Keep separate files if you switch providers.
# ytdlp uses this file for both YouTube cookies and the Apple media-user-token cookie
# (domain .music.apple.com) required for metadata, lyrics, and cover art.
# It never reads the gamdl cookies file.
DOWNLOADER__GAMDL__COOKIES_PATH=/app/data/apple_cookies.txt
DOWNLOADER__YTDLP__COOKIES_PATH=/app/data/youtube_cookies.txt

# ---------------------------------------------------------------------------
# Queue
# ---------------------------------------------------------------------------
# Number of download requests processed in parallel.
TELEGRAM__DOWNLOADS__MAX_CONCURRENCY=2
TELEGRAM__DOWNLOADS__MAX_PENDING_SONGS=2000
TELEGRAM__DOWNLOADS__MAX_PENDING_BULK_PER_USER=1
# Apple Music returns at most 250 items per page.
TELEGRAM__DOWNLOADS__MAX_SONGS_PER_BATCH=250
TELEGRAM__DOWNLOADS__SONGS_PAGE_SIZE=250

# ---------------------------------------------------------------------------
# Popular artist seeding
# ---------------------------------------------------------------------------
# Seeds the bot cache from data/artists.txt (most popular first).
# Set ENABLED=true for background seeding while the bot is running.
SEED__ENABLED=false
SEED__PROVIDER=gamdl
SEED__ARTISTS_FILE=data/artists.txt
SEED__START_INDEX=0
# 0 = all 5000 artists. Start with 50 for a first run.
SEED__MAX_ARTISTS=50
SEED__MAX_SONGS=0
SEED__MAX_SONGS_PER_ARTIST=0
SEED__CONCURRENCY=8
SEED__CATALOG_CONCURRENCY=4
SEED__MAX_ATTEMPTS=3
SEED__MAX_CONSECUTIVE_FAILURES=20
SEED__STATE_PATH=data/seed-state.json
SEED__DRY_RUN=false
SEED__EXIT_WHEN_DONE=false
SEED__INCLUDE_SINGLES=true
SEED__MIN_TRACK_SECONDS=30
SEED__EXCLUDE_ALBUM_PATTERNS=live,remix,deluxe,super deluxe,anniversary,expanded,compilation,greatest hits,best of,essential,anthology,collection,box set,demo,rehearsal,session,instrumental,karaoke,commentary,tour
SEED__EXCLUDE_TRACK_PATTERNS=live,remix,instrumental,karaoke,commentary,demo,rehearsal,take
SEED__ARTIST_MATCH_THRESHOLD=0.82
SEED__FALLBACK_ARTIST_SONGS=true
SEED__FALLBACK_ARTIST_SONGS_LIMIT=50

# ---------------------------------------------------------------------------
# Local Bot API profile (docker compose --profile local-api)
# ---------------------------------------------------------------------------
# TELEGRAM_API_ID=
# TELEGRAM_API_HASH=

# ---------------------------------------------------------------------------
# Storage paths (compose)
# ---------------------------------------------------------------------------
# BOT_DATA_PATH=./data/bot
# TG_DATA_PATH=./data/telegram

# ---------------------------------------------------------------------------
# Logging
# ---------------------------------------------------------------------------
LOGGING__LOGLEVEL__DEFAULT=Debug
